{%- set _pbs_volumes = pbs_extra_volumes | default([]) -%}
{%- set _pbs_caps = pbs_cap_add | default([]) -%}
{%- set _pbs_cgroup_rules = pbs_device_cgroup_rules | default([]) -%}
{%- if pbs_disk_identity | default(false) -%}
{%-   set _pbs_volumes = (_pbs_volumes + ['/run/udev:/run/udev:ro', '/dev:/dev']) | unique -%}
{%-   set _pbs_caps = (_pbs_caps + ['SYS_RAWIO', 'SYS_ADMIN']) | unique -%}
{%-   if not pbs_devices and not _pbs_cgroup_rules -%}
{%-     set _pbs_cgroup_rules = ['b *:* r'] -%}
{%-   endif -%}
{%- endif -%}
volumes:
  lib:

services:
  pbs:
    image: {{ pbs_image }}
    mem_limit: 2G
    volumes:
      - ./etc:/etc/proxmox-backup
      - ./logs:/var/log/proxmox-backup
      - lib:/var/lib/proxmox-backup
{% if pbs_ssl_certificate and pbs_ssl_certificate_key %}
      - {{ pbs_ssl_certificate }}:/etc/proxmox-backup/proxy.pem:ro
      - {{ pbs_ssl_certificate_key }}:/etc/proxmox-backup/proxy.key:ro
{% endif %}
      - {{ pbs_storage_dir }}:/mnt/backups
{% for volume in _pbs_volumes %}
      - {{ volume }}
{% endfor %}
    tmpfs:
      - /run
{% if pbs_devices %}
    devices:
{% for device in pbs_devices %}
      - {{ device }}
{% endfor %}
{% endif %}
{% if _pbs_cgroup_rules %}
    device_cgroup_rules:
{% for rule in _pbs_cgroup_rules %}
      - '{{ rule }}'
{% endfor %}
{% endif %}
{% if _pbs_caps %}
    cap_add:
{% for cap in _pbs_caps %}
      - {{ cap }}
{% endfor %}
{% endif %}
    environment:
      TZ: {{ pbs_timezone }}
    restart: unless-stopped
    stop_signal: SIGHUP
    healthcheck:
      test: ["CMD", "curl", "-k", "-f", "https://localhost:8007"]
      interval: 15s
      timeout: 10s
      retries: 3
      start_period: 30s
{% if pbs_network_mode == "host" %}
    network_mode: host
{% else %}
    ports:
      - '8007:8007/tcp'
{% endif %}

